# Payload and Supabase Postgres
DATABASE_URI=
PAYLOAD_SECRET=

# Supabase Storage (S3-compatible API)
S3_ENDPOINT=
S3_BUCKET=media
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Transactional email
RESEND_KEY=

# Eventbrite (only required when the events integration is enabled)
EVENT_TOKEN=
EVENT_ORG_ID=

# Legacy Careers import — source sheet shared "Anyone with the link → Viewer".
# Optional one-time legacy import only; the public careers board uses the CMS.
# CAREERS_SHEET_ID is the part of the sheet URL between /d/ and /edit (pasting the
# whole URL also works). CAREERS_SHEET_GID is the number after #gid= with the Jobs
# tab open; leave blank if Jobs is the first tab. See README "Careers board".
# Leave both blank to show the "board's still being wired up" state.
CAREERS_SHEET_ID=
CAREERS_SHEET_GID=
# Import testing only: read an http(s) CSV instead of Google.
CAREERS_CSV_URL=
